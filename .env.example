# Copy to .env and set the values
ODM_JWT_SECRET=please-set-a-secret-of-at-least-32-characters
ODM_ADMIN_USER=admin
ODM_ADMIN_PASSWORD=please-change
ODM_DB_PASSWORD=please-change
# Key for stored secrets: openssl rand -base64 32  (keep it safe; without it stored secrets are unreadable)
ODM_SECRETS_KEY=
ODM_S3_PASSWORD=please-change-min-8-characters

# Optional: agent self-update (default: off)
# Mode: Off | Latest (newest version, upgrades only) | Pinned (exactly ODM_AGENT_UPDATE_VERSION, downgrades allowed)
ODM_AGENT_UPDATE_MODE=Off
ODM_AGENT_UPDATE_VERSION=
# Share of devices that receive the update (0-100); raise step by step
ODM_AGENT_UPDATE_PERCENT=100
# Public address of the server for the install scripts, e.g. https://odm.example.org (empty = derived from the request)
ODM_PUBLIC_URL=

# Optional: behind your own reverse proxy (nginx proxy manager, Traefik ...); not needed for deploy/docker-compose.https.yml
# Take client address and scheme from X-Forwarded-For / -Proto
ODM_PROXY_FORWARDED_HEADERS=false
# Address or CIDR range of the proxy as ODM sees it (required when the line above is true, otherwise ODM does not start),
# e.g. 192.168.10.5 (proxy on another host) or 172.18.0.0/16 (proxy container in a Docker network)
ODM_TRUSTED_PROXY=
# Only if ODM is reachable through the proxy alone and the proxy address cannot be named: believe every peer
# ODM_PROXY_TRUST_ALL=true
# Interface for port 8080: 0.0.0.0 = all; 127.0.0.1 = only this host (proxy on the same host, nobody can bypass it)
ODM_BIND=0.0.0.0

# Optional: authenticate agents with a client certificate (mTLS): Off | Optional | Required. Requires HTTPS directly at the ODM server.
ODM_MTLS_MODE=Off

# Optional: HTTPS variant (deploy/docker-compose.https.yml)
# Public DNS name of the server; agents and browsers use https://<ODM_DOMAIN>
ODM_DOMAIN=
# Certificate source: empty = Let's Encrypt, "internal" = Caddy's own CA, "/certs/fullchain.pem /certs/key.pem" = your files in ./certs
ODM_CADDY_TLS=
# Proxy network range (change only if it collides with an existing network)
# ODM_PROXY_SUBNET=172.31.250.0/24
# Agent client certificates behind the proxy: use the mTLS Caddyfile and set ODM_MTLS_MODE above
# ODM_PROXY_CADDYFILE=./deploy/Caddyfile.mtls
