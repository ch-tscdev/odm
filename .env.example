# Open Device Manager: the only file administrators edit for a Docker Compose installation.
# Copy to .env, set the required values, uncomment and set optional ones, then: docker compose up -d --build
# Lists (several e-mail addresses, group values, events) are separated by commas.

# =====================================================================================================================
# Required
# =====================================================================================================================

# Signs session tokens, at least 32 characters: openssl rand -base64 48
ODM_JWT_SECRET=please-set-a-secret-of-at-least-32-characters
# Bootstrap administrator, created on first start when no user exists (keep it as emergency access)
ODM_ADMIN_USER=admin
ODM_ADMIN_PASSWORD=please-change
# Password of the bundled database (SQL Server: upper and lower case letters and digits, no ';')
ODM_DB_PASSWORD=please-change
# Key for stored secrets: openssl rand -base64 32  (keep it safe; without it stored secrets are unreadable)
ODM_SECRETS_KEY=
# Password of the bundled package store, at least 8 characters
ODM_S3_PASSWORD=please-change-min-8-characters

# =====================================================================================================================
# Variant: which compose files are used (separator ':' on Linux/macOS, ';' on Windows)
# =====================================================================================================================
# Default: ODM on port 8080 with PostgreSQL and the bundled S3 store
# COMPOSE_FILE=docker-compose.yml
# HTTPS with the bundled Caddy proxy (set ODM_DOMAIN below):
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.https.yml
# SQL Server instead of PostgreSQL (combinable with HTTPS):
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.mssql.yml

# =====================================================================================================================
# Network and address
# =====================================================================================================================

# Public address of the server, e.g. https://odm.example.org (install scripts, OIDC). Empty = derived from the request.
ODM_PUBLIC_URL=
# Interface and port for HTTP: 0.0.0.0 = all interfaces; 127.0.0.1 = only this host (proxy on the same host)
ODM_BIND=0.0.0.0
# ODM_PORT=8080

# Behind your own reverse proxy (nginx proxy manager, Traefik ...); not needed for the bundled Caddy variant
ODM_PROXY_FORWARDED_HEADERS=false
# Address or CIDR range of the proxy as ODM sees it; required when the line above is true (otherwise ODM does not start),
# e.g. 192.168.10.5 (proxy on another host) or 172.18.0.0/16 (proxy container in a Docker network)
ODM_TRUSTED_PROXY=
# Only if ODM is reachable through the proxy alone and its address cannot be named: believe every peer
# ODM_PROXY_TRUST_ALL=true

# HTTPS directly at ODM (e.g. agent client certificates without a proxy): PEM files in ./certs, served on ODM_TLS_PORT
# ODM_TLS_CERT=fullchain.pem
# ODM_TLS_KEY=privkey.pem
# ODM_TLS_PORT=8443

# Bundled Caddy proxy (COMPOSE_FILE with deploy/docker-compose.https.yml)
# Public DNS name; agents and browsers use https://<ODM_DOMAIN>
ODM_DOMAIN=
# Certificate: empty = Let's Encrypt, "internal" = Caddy's own CA, "/certs/fullchain.pem /certs/key.pem" = files in ./certs
ODM_CADDY_TLS=
# ODM_HTTP_PORT=80
# ODM_HTTPS_PORT=443
# Proxy network range (change only if it collides with an existing network)
# ODM_PROXY_SUBNET=172.31.250.0/24
# Agent client certificates behind Caddy: use the mTLS Caddyfile and set ODM_MTLS_MODE below
# ODM_PROXY_CADDYFILE=./deploy/Caddyfile.mtls

# =====================================================================================================================
# External database and package store (optional; the bundled ones then stay unused)
# =====================================================================================================================

# Complete connection string, e.g. Host=pg.example.org;Database=odm;Username=odm;Password=...  (SQL Server: Server=...;...)
# ODM_DB_CONNECTION=
# Any S3-compatible service (AWS S3, MinIO, ...)
# ODM_S3_URL=https://s3.example.org
# ODM_S3_REGION=us-east-1
# ODM_S3_BUCKET=odm-packages
# ODM_S3_ACCESS_KEY=
# ODM_S3_SECRET_KEY=
# true for MinIO/RustFS, false for AWS S3 virtual-hosted buckets
# ODM_S3_PATH_STYLE=true

# =====================================================================================================================
# Sign-in (see docs/authentication.md)
# =====================================================================================================================

# Lifetime of a session in minutes
# ODM_SESSION_MINUTES=60

# LDAP / Active Directory
ODM_LDAP_ENABLED=false
# ODM_LDAP_HOST=dc01.example.org
# ODM_LDAP_PORT=636
# Ldaps | StartTls
# ODM_LDAP_SECURITY=Ldaps
# ODM_LDAP_BASE_DN=DC=example,DC=org
# ODM_LDAP_BIND_DN=CN=svc-odm,OU=Service,DC=example,DC=org
# ODM_LDAP_BIND_PASSWORD=
# ODM_LDAP_USER_FILTER=(sAMAccountName={0})
# ODM_LDAP_DISPLAY_NAME_ATTRIBUTE=displayName
# ODM_LDAP_GROUP_ATTRIBUTE=memberOf
# ODM_LDAP_ADMIN_GROUP=CN=ODM-Admins,OU=Groups,DC=example,DC=org
# ODM_LDAP_OPERATOR_GROUP=
# ODM_LDAP_READONLY_GROUP=

# OpenID Connect (Entra ID, authentik, Keycloak ...); one provider. Redirect URI: <public address>/api/auth/oidc/callback
# ODM_OIDC_ID=entra
# ODM_OIDC_DISPLAY_NAME=Microsoft
# ODM_OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
# ODM_OIDC_CLIENT_ID=
# ODM_OIDC_CLIENT_SECRET=
# Group claim values per role (comma-separated); without a match the sign-in is rejected
# ODM_OIDC_ADMIN_VALUES=
# ODM_OIDC_OPERATOR_VALUES=
# ODM_OIDC_READONLY_VALUES=
# ODM_OIDC_GROUPS_CLAIM=groups
# ODM_OIDC_USERNAME_CLAIM=preferred_username
# ODM_OIDC_DISPLAY_NAME_CLAIM=name
# Empty = openid, profile, email
# ODM_OIDC_SCOPES=
# Only if it differs from ODM_PUBLIC_URL
# ODM_OIDC_PUBLIC_URL=

# =====================================================================================================================
# Agents (see docs/agent.md)
# =====================================================================================================================

# Self-update: Off | Latest (newest version, upgrades only) | Pinned (exactly ODM_AGENT_UPDATE_VERSION, downgrades allowed)
ODM_AGENT_UPDATE_MODE=Off
ODM_AGENT_UPDATE_VERSION=
# Share of devices that receive the update (0-100); raise step by step
ODM_AGENT_UPDATE_PERCENT=100
# ODM_AGENT_HEARTBEAT_SECONDS=60

# Client certificates (mTLS): Off | Optional | Required. Needs HTTPS at ODM (ODM_TLS_CERT) or a proxy that forwards them.
ODM_MTLS_MODE=Off
# Header in which your own proxy forwards the client certificate (the bundled Caddy variant sets it itself)
# ODM_MTLS_FORWARDED_HEADER=X-Client-Cert
# ODM_MTLS_CERT_DAYS=365
# ODM_MTLS_RENEW_DAYS=30

# =====================================================================================================================
# Software distribution and OS updates
# =====================================================================================================================

# Upload limit for PSADT packages in MB (also used by the bundled Caddy proxy; S3 single upload: 5 GB maximum)
# ODM_MAX_PACKAGE_MB=4096
# ODM_RECONCILE_SECONDS=60
# How often auto-updating repository packages are refreshed (0 = never)
# ODM_REPO_REFRESH_HOURS=24
# How often maintenance windows are evaluated
# ODM_OS_UPDATE_CHECK_SECONDS=60

# =====================================================================================================================
# Notifications (see docs/operations.md#notifications)
# =====================================================================================================================

ODM_NOTIFY_ENABLED=false
# Alert types (comma-separated); empty = all
# ODM_NOTIFY_EVENTS=
# ODM_NOTIFY_CHECK_MINUTES=5
# ODM_NOTIFY_SILENT_HOURS=24
# ODM_NOTIFY_CERT_DAYS=7
# ODM_NOTIFY_MAX_PER_MESSAGE=50
# E-mail; ODM_SMTP_SECURITY: StartTls | None (local relay)
# ODM_SMTP_HOST=
# ODM_SMTP_PORT=587
# ODM_SMTP_SECURITY=StartTls
# ODM_SMTP_USER=
# ODM_SMTP_PASSWORD=
# ODM_SMTP_FROM=odm@example.org
# ODM_SMTP_TO=it@example.org, oncall@example.org
# Webhook (Slack, Mattermost, Teams workflow); optional Authorization header value
# ODM_WEBHOOK_URL=
# ODM_WEBHOOK_AUTHORIZATION=

# =====================================================================================================================
# Retention in days (0 = keep forever) and logging
# =====================================================================================================================

# ODM_RETENTION_JOBS_DAYS=90
# ODM_RETENTION_TOKENS_DAYS=30
# ODM_RETENTION_OS_UPDATES_DAYS=365
# ODM_RETENTION_AUDIT_DAYS=365
# ODM_RETENTION_NOTIFICATIONS_DAYS=180

# Trace | Debug | Information | Warning | Error. ODM_LOG_LEVEL_ODM applies to ODM's own components (e.g. Debug for
# troubleshooting OS update scheduling), ODM_LOG_LEVEL to everything else.
# ODM_LOG_LEVEL=Information
# ODM_LOG_LEVEL_ODM=Information
